<UserControl xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="using:Westcoast_Education_Avalonia.ViewModels"
        mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
        x:Class="Westcoast_Education_Avalonia.Views.AddCourseView"
        x:DataType="vm:AddCourseViewModel"
        

        >
 <StackPanel Margin="24"
                Spacing="12"
                HorizontalAlignment="Center">

        <TextBlock Text="{Binding PageTitle}"
                   FontSize="28"
                   Foreground="{DynamicResource HeadingBrush}" />

        <TextBlock Text="Course Number" />
        <TextBox Text="{Binding CourseNumber}" />

        <TextBlock Text="Course Title" />
        <TextBox Text="{Binding Title}" />
        <StackPanel HorizontalAlignment="Center">

        <CheckBox Content="Remote course"
         IsChecked="{Binding Remote}" />
        <TextBlock Text="Duration" />
        <TextBox Text="{Binding Duration}" />

        <TextBlock Text="Start date (YYYY-MM-DD)" />
        <TextBox Text="{Binding StartDate}" />

        <TextBlock Text="End date (YYYY-MM-DD)" />
        <TextBox Text="{Binding EndDate}" />

        <TextBlock Text="Teacher" />
        <TextBox Text="{Binding TeacherName}" />

        <TextBlock Text="{Binding Message}" />
        </StackPanel>
                

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="0,12,0,0">

            <Button Content="Save"
                    Command="{Binding SaveCommand}" />

            <Button Content="Exit"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).GoToCoursesCommand}" />
        </StackPanel>
    </StackPanel>


</UserControl>
