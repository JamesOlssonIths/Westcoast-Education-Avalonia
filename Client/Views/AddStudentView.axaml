<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Westcoast_Education_Avalonia.ViewModels"
             x:Class="Westcoast_Education_Avalonia.Views.AddStudentView"
             x:DataType="vm:AddStudentViewModel">
      
        <StackPanel
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        >
        
          <TextBlock Text="Student Form goes here"/>
          <StackPanel>
            <TextBox PlaceholderText="FirstName" Text="{Binding FirstName}"> </TextBox>
            <TextBox PlaceholderText="LastName" Text="{Binding LastName}" > </TextBox>
            <TextBox PlaceholderText="Phone number" Text="{Binding PhoneNumber}"> </TextBox>
            <TextBox PlaceholderText="Socail sec number" Text="{Binding SocialSecurityNumber}"> </TextBox>
          </StackPanel>

          <StackPanel Spacing="80" Orientation="Horizontal">
            <Button Content="Save" />
            <Button  Content="Exit" Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).GoToStudentsCommand}" /> 
          </StackPanel>
      </StackPanel>
    </UserControl>
