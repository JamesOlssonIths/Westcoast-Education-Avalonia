<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Westcoast_Education_Avalonia.ViewModels"
             x:Class="Westcoast_Education_Avalonia.Views.EditTeacherView"
             x:DataType="vm:EditTeacherViewModel">

    <StackPanel Margin="24"
                Spacing="12"
                HorizontalAlignment="Center">

        <TextBlock Text="{Binding PageTitle}"
                   FontSize="28"
                   Foreground="{DynamicResource HeadingBrush}" />

        <TextBlock Text="First name" />
        <TextBox Text="{Binding FirstName}" />

        <TextBlock Text="Last name" />
        <TextBox Text="{Binding LastName}" />

        <TextBlock Text="Phone number" />
        <TextBox Text="{Binding PhoneNumber}" />

        <TextBlock Text="Social security number" />
        <TextBox Text="{Binding SocialSecurityNumber}" />

        <TextBlock Text="Street" />
        <TextBox Text="{Binding Street}" />

        <TextBlock Text="Postal code" />
        <TextBox Text="{Binding PostalCode}" />

        <TextBlock Text="City" />
        <TextBox Text="{Binding City}" />

        <TextBlock Text="Knowledge area" />
        <TextBox Text="{Binding KnowledgeArea}" />

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Spacing="12"
                    Margin="0,12,0,0">

            <Button Content="Save"
                    Command="{Binding SaveCommand}" />

            <Button Content="Exit"
                    Command="{Binding $parent[Window].((vm:MainViewModel)DataContext).GoToTeachersCommand}" />
        </StackPanel>
    </StackPanel>
</UserControl>